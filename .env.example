# Copy to .env and edit.  NEVER commit .env
# Generate a key with:  openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Port exposed on the VPS
HOST_PORT=8000

# Chromium tabs in parallel. 1 GB RAM VPS -> 2, 4 GB -> 4, Ampere A1 (12+ GB) -> 10
MAX_PARALLEL_TABS=3
HUBDRIVE_RETRIES=3
REQUEST_TIMEOUT=120
